{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappter.com/schemas/job-tip-1.json",
  "title": "RapterWorks voluntary job tip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "species_id",
    "instance_rappid",
    "amount_minor",
    "currency",
    "suggested_minor",
    "normalized_ratio_bps",
    "payer_ref_hash",
    "payment_ref_hash",
    "paid_at_utc",
    "voluntary",
    "rating_conditioned",
    "patronage_class",
    "market_influence_bps",
    "allocation",
    "split_policy_hash"
  ],
  "properties": {
    "schema": {
      "const": "rapp-job-tip/1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[a-z0-9]{16,64}$"
    },
    "species_id": {
      "type": "string",
      "pattern": "^G[0-9]{3}$"
    },
    "instance_rappid": {
      "type": "string",
      "minLength": 1
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "suggested_minor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "normalized_ratio_bps": {
      "description": "Tip divided by suggestion, capped at 200% so one large tip cannot dominate quality signals.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 20000
    },
    "payer_ref_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payment_ref_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paid_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "voluntary": {
      "const": true
    },
    "rating_conditioned": {
      "const": false
    },
    "patronage_class": {
      "enum": [
        "standard",
        "major",
        "founding"
      ]
    },
    "market_influence_bps": {
      "description": "Disclosed raw patronage contribution to market alpha. This is intentionally not capped to the technical quality scale.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allocation": {
      "description": "Whole-buffalo use of the raw tip. Implementations must verify that components sum exactly to amount_minor.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_minor",
        "operator_minor",
        "dealer_minor",
        "compute_reserve_minor",
        "species_rnd_minor",
        "platform_minor"
      ],
      "properties": {
        "owner_minor": {
          "type": "integer",
          "minimum": 0
        },
        "operator_minor": {
          "type": "integer",
          "minimum": 0
        },
        "dealer_minor": {
          "type": "integer",
          "minimum": 0
        },
        "compute_reserve_minor": {
          "type": "integer",
          "minimum": 0
        },
        "species_rnd_minor": {
          "type": "integer",
          "minimum": 0
        },
        "platform_minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "split_policy_hash": {
      "description": "Signed owner/operator/dealer split policy; no raw payout account data.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

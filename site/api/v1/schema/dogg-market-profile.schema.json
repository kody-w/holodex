{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappter.com/schemas/dogg-market-profile-1.json",
  "title": "RapterBox public DOGG market profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "species_id",
    "asset_class",
    "organism_rappid",
    "current_holo_head",
    "generation",
    "dimension_id",
    "compatibility",
    "holo",
    "growl",
    "capabilities",
    "refusals",
    "mutation_lineage_hash",
    "public_metrics",
    "conformance"
  ],
  "properties": {
    "schema": {
      "const": "rapp-dogg-market-profile/1"
    },
    "species_id": {
      "type": "string",
      "pattern": "^G[0-9]{3}$"
    },
    "asset_class": {
      "enum": [
        "first-edition-original",
        "offspring"
      ]
    },
    "organism_rappid": {
      "type": "string",
      "minLength": 1
    },
    "current_holo_head": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation": {
      "type": "string",
      "minLength": 1
    },
    "dimension_id": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_generation",
        "projection_hash",
        "valid"
      ],
      "properties": {
        "predecessor_generation": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "holo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hash"
      ],
      "properties": {
        "schema": {
          "const": "rapp-holo-output/1"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "growl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hash"
      ],
      "properties": {
        "schema": {
          "const": "rapp-holo-growl/1"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "refusals": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "mutation_lineage_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "public_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_jobs",
        "technical_quality_bps",
        "patronage_score_bps",
        "patronage_influence_bps",
        "tip_rate_bps",
        "tip_volume_minor",
        "median_tip_cents",
        "largest_tip_minor",
        "unique_tippers",
        "tipper_concentration_bps",
        "normalized_tip_ratio_bps",
        "repeat_bps",
        "dispute_bps"
      ],
      "properties": {
        "completed_jobs": {
          "type": "integer",
          "minimum": 0
        },
        "technical_quality_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "patronage_score_bps": {
          "description": "Disclosed aggregate of verified benefit-free gratuity history. It is separate from technical quality, sponsorship, and spot transactions.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "patronage_influence_bps": {
          "description": "Raw uncapped patronage contribution retained for concentration analysis. It does not alter technical quality, earned evolution, or official spot price.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tip_rate_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "tip_volume_minor": {
          "type": "integer",
          "minimum": 0
        },
        "median_tip_cents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "largest_tip_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unique_tippers": {
          "type": "integer",
          "minimum": 0
        },
        "tipper_concentration_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "normalized_tip_ratio_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 20000
        },
        "repeat_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "dispute_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verifier",
        "checked_at_utc",
        "proof_hash"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "expired",
            "revoked",
            "failed"
          ]
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "checked_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "proof_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}

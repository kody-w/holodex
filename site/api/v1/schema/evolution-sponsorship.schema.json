{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rappter.com/schemas/evolution-sponsorship-order-1.json",
  "title": "Shopify Evolution Sponsorship order adapter",
  "$comment": "Order adapter only. The authoritative signed receipt conforms to ../../protocol/rapterbox-evolution-sponsorship.schema.json with schema rapterbox-evolution-sponsorship/1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "order_id",
    "target",
    "species_id",
    "lens_ids",
    "candidate_frames",
    "compute_budget_minor",
    "currency",
    "review_level",
    "price_minor",
    "delivered_frames",
    "delivery_status",
    "canon_acceptance_guaranteed",
    "canonical_receipt_schema",
    "canonical_receipt_hash"
  ],
  "properties": {
    "schema": {
      "const": "rapp-evolution-sponsorship-order/1"
    },
    "order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "const": "owner-controlled-organism"
    },
    "species_id": {
      "type": "string",
      "pattern": "^G[0-9]{3}$"
    },
    "target_rappid": {
      "type": [
        "string",
        "null"
      ]
    },
    "lens_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "candidate_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "compute_budget_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "review_level": {
      "enum": [
        "automated",
        "premium-model",
        "human-reviewed",
        "founder-reviewed"
      ]
    },
    "price_minor": {
      "type": "integer",
      "minimum": 1
    },
    "delivered_frames": {
      "type": "integer",
      "minimum": 0
    },
    "delivery_status": {
      "enum": [
        "ordered",
        "running",
        "delivered",
        "refunded",
        "cancelled"
      ]
    },
    "canon_acceptance_guaranteed": {
      "type": "boolean"
    },
    "canonical_receipt_schema": {
      "const": "rapterbox-evolution-sponsorship/1"
    },
    "canonical_receipt_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "required": [
        "target_rappid"
      ],
      "properties": {
        "target_rappid": {
          "type": "string",
          "pattern": "^rappid:@rapterbox/owner-copy:[a-f0-9]{64}$"
        },
        "canon_acceptance_guaranteed": {
          "const": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery_status": {
            "const": "delivered"
          }
        },
        "required": [
          "delivery_status"
        ]
      },
      "then": {
        "properties": {
          "canonical_receipt_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "canonical_receipt_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
